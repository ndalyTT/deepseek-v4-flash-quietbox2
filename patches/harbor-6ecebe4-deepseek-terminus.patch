 from typing import Any, NoReturn, override
 
@@ -58,6 +61,343 @@ Here is the prompt:
 """
 
 
+def _first_complete_json_object(response: str) -> str | None:
+    """Return the first balanced, valid JSON object in a partial response."""
+
+    start = None
+    depth = 0
+    in_string = False
+    escape_next = False
+
+    for index, char in enumerate(response):
+        if start is None:
+            if char != "{":
+                continue
+            start = index
+            depth = 1
+            in_string = False
+            escape_next = False
+            continue
+
+        if escape_next:
+            escape_next = False
+            continue
+        if in_string and char == "\\":
+            escape_next = True
+            continue
+        if char == '"':
+            in_string = not in_string
+            continue
+        if in_string:
+            continue
+        if char == "{":
+            depth += 1
+        elif char == "}":
+            depth -= 1
+            if depth == 0:
+                candidate = response[start : index + 1]
+                try:
+                    value = json.loads(candidate)
+                except json.JSONDecodeError:
+                    start = None
+                    continue
+                if isinstance(value, dict):
+                    return candidate
+                start = None
+
+    return None
+
+
+_KEYSTROKES_PREFILL = '{"commands":[{"keystrokes":"'
+_TASK_COMPLETE_SENTINEL = "DONE"
+_DSML_TOKEN = "｜DSML｜"
+_NATIVE_PARAMETER_END = f"</{_DSML_TOKEN}parameter>"
+_NATIVE_KEYSTROKES_PREFILL = (
+    f"<{_DSML_TOKEN}tool_calls>\n"
+    f'<{_DSML_TOKEN}invoke name="bash_command">\n'
+    f'<{_DSML_TOKEN}parameter name="keystrokes" string="true">'
+)
+_NATIVE_BASH_TOOL = {
+    "type": "function",
+    "function": {
+        "name": "bash_command",
+        "description": "Send exact keystrokes to the Linux terminal.",
+        "parameters": {
+            "type": "object",
+            "properties": {"keystrokes": {"type": "string"}},
+            "required": ["keystrokes"],
+        },
+    },
+}
+_NATIVE_COMPLETE_TOOL = {
+    "type": "function",
+    "function": {
+        "name": "mark_task_complete",
+        "description": "Mark the terminal task complete only after verifying the result.",
+        "parameters": {"type": "object", "properties": {}},
+    },
+}
+_NATIVE_TERMINAL_SYSTEM_MESSAGE = {
+    "role": "system",
+    "content": (
+        "Solve the task in the Linux terminal. Call bash_command for exactly one "
+        "concrete action at a time. Do not repeat a successful command. Call "
+        "mark_task_complete only after the requested result is implemented and "
+        "verified."
+    ),
+    "tools": [_NATIVE_BASH_TOOL, _NATIVE_COMPLETE_TOOL],
+}
+
+
+def _normalized_keystrokes_action(keystrokes: str) -> str:
+    if keystrokes.strip().upper() == _TASK_COMPLETE_SENTINEL:
+        return '{"commands":[],"task_complete":true}'
+
+    control_keys = {"C-c", "C-d", "C-z"}
+    if keystrokes and not keystrokes.endswith("\n") and keystrokes not in control_keys:
+        keystrokes += "\n"
+    return json.dumps(
+        {"commands": [{"keystrokes": keystrokes, "duration": 1.0}]},
+        separators=(",", ":"),
+    )
+
+
+def _native_prefilled_keystrokes_action(
+    response: str,
+    prefix: str,
+    *,
+    stopped: bool = False,
+) -> str | None:
+    """Normalize the command value from an official DSML parameter prefill."""
+
+    if prefix != _NATIVE_KEYSTROKES_PREFILL or not response.startswith(prefix):
+        return None
+    suffix = response[len(prefix) :]
+    value_end = suffix.find(_NATIVE_PARAMETER_END)
+    if value_end >= 0:
+        keystrokes = suffix[:value_end]
+    elif stopped:
+        keystrokes = suffix
+    else:
+        return None
+    if not keystrokes.strip():
+        return None
+    return _normalized_keystrokes_action(keystrokes)
+
+
+def _first_native_terminal_action(response: str) -> str | None:
+    """Normalize the first complete DeepSeek DSML terminal tool invocation."""
+
+    invoke = f"<{_DSML_TOKEN}invoke name=\""
+    begin = response.find(invoke)
+    while begin >= 0:
+        name_begin = begin + len(invoke)
+        name_end = response.find('">', name_begin)
+        if name_end < 0:
+            return None
+        name = response[name_begin:name_end]
+        invoke_end = f"</{_DSML_TOKEN}invoke>"
+        end = response.find(invoke_end, name_end)
+        if end < 0:
+            return None
+        block = response[name_end + 2 : end]
+
+        if name == "mark_task_complete":
+            return '{"commands":[],"task_complete":true}'
+        if name == "bash_command":
+            parameter = (
+                f'<{_DSML_TOKEN}parameter name="keystrokes" string="true">'
+            )
+            value_begin = block.find(parameter)
+            if value_begin >= 0:
+                value_begin += len(parameter)
+                value_end = block.find(f"</{_DSML_TOKEN}parameter>", value_begin)
+                if value_end >= 0:
+                    return _normalized_keystrokes_action(
+                        block[value_begin:value_end]
+                    )
+
+        begin = response.find(invoke, end + len(invoke_end))
+    return None
+
+
+def _first_json_terminal_action(response: str) -> str | None:
+    """Normalize a valid Terminus action if the model follows the JSON prompt."""
+
+    json_content = _first_complete_json_object(response)
+    if json_content is None:
+        return None
+    try:
+        action = json.loads(json_content)
+    except json.JSONDecodeError:
+        return None
+    if action.get("task_complete"):
+        return '{"commands":[],"task_complete":true}'
+    commands = action.get("commands")
+    if not isinstance(commands, list) or not commands:
+        return None
+    command = commands[0]
+    if isinstance(command, str):
+        return _normalized_keystrokes_action(command)
+    if isinstance(command, dict) and isinstance(command.get("keystrokes"), str):
+        return _normalized_keystrokes_action(command["keystrokes"])
+    return None
+
+
+def _native_terminal_messages(messages: list[dict[str, Any]]) -> list[dict[str, Any]]:
+    """Convert normalized Terminus turns back to DeepSeek-native tool history."""
+
+    converted: list[dict[str, Any]] = [dict(_NATIVE_TERMINAL_SYSTEM_MESSAGE)]
+    pending_tool_call_id: str | None = None
+    call_index = 0
+    for message in messages:
+        role = message.get("role")
+        content = message.get("content") or ""
+        if role == "assistant":
+            json_content = _first_complete_json_object(content)
+            if json_content is None:
+                converted.append({"role": "assistant", "content": content})
+                pending_tool_call_id = None
+                continue
+            try:
+                action = json.loads(json_content)
+            except json.JSONDecodeError:
+                converted.append({"role": "assistant", "content": content})
+                pending_tool_call_id = None
+                continue
+
+            call_index += 1
+            pending_tool_call_id = f"terminal_call_{call_index}"
+            if action.get("task_complete"):
+                function = {"name": "mark_task_complete", "arguments": "{}"}
+            else:
+                commands = action.get("commands")
+                if not isinstance(commands, list) or not commands:
+                    converted.append({"role": "assistant", "content": content})
+                    pending_tool_call_id = None
+                    continue
+                command = commands[0]
+                if not isinstance(command, dict) or not isinstance(
+                    command.get("keystrokes"), str
+                ):
+                    converted.append({"role": "assistant", "content": content})
+                    pending_tool_call_id = None
+                    continue
+                function = {
+                    "name": "bash_command",
+                    "arguments": json.dumps(
+                        {"keystrokes": command["keystrokes"]},
+                        ensure_ascii=False,
+                    ),
+                }
+            converted.append(
+                {
+                    "role": "assistant",
+                    "content": "",
+                    "tool_calls": [
+                        {
+                            "id": pending_tool_call_id,
+                            "type": "function",
+                            "function": function,
+                        }
+                    ],
+                }
+            )
+        elif role == "user" and pending_tool_call_id is not None:
+            converted.append(
+                {
+                    "role": "tool",
+                    "tool_call_id": pending_tool_call_id,
+                    "content": content,
+                }
+            )
+            pending_tool_call_id = None
+        else:
+            converted.append(dict(message))
+            pending_tool_call_id = None
+    return converted
+
+
+def _first_prefilled_keystrokes_action(
+    response: str,
+    prefix: str,
+) -> str | None:
+    """Build a valid action as soon as a prefixed keystrokes string closes.
+
+    The aggressively quantized DeepSeek V4 model reliably produces the command
+    string but can loop while producing the surrounding action fields.  Capture
+    the first string and supply that mechanical envelope locally.
+    """
+
+    if prefix != _KEYSTROKES_PREFILL or not response.startswith(prefix):
+        return None
+
+    suffix = response[len(prefix) :]
+    escape_next = False
+    for index, char in enumerate(suffix):
+        if escape_next:
+            escape_next = False
+            continue
+        if char == "\\":
+            escape_next = True
+            continue
+        if char != '"':
+            continue
+
+        try:
+            keystrokes = json.loads('"' + suffix[: index + 1])
+        except json.JSONDecodeError:
+            return None
+        if not isinstance(keystrokes, str):
+            return None
+
+        return _normalized_keystrokes_action(keystrokes)
+
+    return None
+
+
+def _stopped_prefilled_keystrokes_action(
+    response: str,
